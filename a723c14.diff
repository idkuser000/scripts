From a723c1431987aec6e44f5ef20c9424a95727adf8 Mon Sep 17 00:00:00 2001
From: Yumi Yukimura <me.cafebabe@gmail.com>
Date: Wed, 10 Dec 2025 01:04:22 +0800
Subject: [PATCH] HACK: selinux: Force permissive when `androidboot.selinux=permissive`

* Helps debugging Android's user builds

Change-Id: I5cec94d6db1e2ec68e2d6898919cf347d02d3372
---

diff --git a/kernel/mainline/android-mainline/security/selinux/selinuxfs.c b/kernel/mainline/android-mainline/security/selinux/selinuxfs.c
index 73fb4be..1baff03 100644
--- a/kernel/mainline/android-mainline/security/selinux/selinuxfs.c
+++ b/kernel/mainline/android-mainline/security/selinux/selinuxfs.c
@@ -133,6 +133,19 @@ static ssize_t sel_read_enforce(struct file *filp, char __user *buf,
 }
 
 #ifdef CONFIG_SECURITY_SELINUX_DEVELOP
+bool force_permissive = false;
+
+static int __init androidboot_selinux_setup(char *line)
+{
+	if (!strcmp(line, "permissive")) {
+		pr_warn("SELinux: Force permissive as requested\n");
+		force_permissive = true;
+	}
+        return 1;
+}
+
+__setup("androidboot.selinux=", androidboot_selinux_setup);
+
 static ssize_t sel_write_enforce(struct file *file, const char __user *buf,
 				 size_t count, loff_t *ppos)
 
@@ -158,6 +171,8 @@ static ssize_t sel_write_enforce(struct file *file, const char __user *buf,
 		goto out;
 
 	new_value = !!scan_value;
+	if (force_permissive)
+		new_value = 0;
 
 	old_value = enforcing_enabled();
 	if (new_value != old_value) {
