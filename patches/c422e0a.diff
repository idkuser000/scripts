diff --git a/kernel/mainline/android-mainline/drivers/gpu/drm/vmwgfx/vmwgfx_kms.h b/kernel/mainline/android-mainline/drivers/gpu/drm/vmwgfx/vmwgfx_kms.h
index 2a6c6d6..c638d6b 100644
--- a/kernel/mainline/android-mainline/drivers/gpu/drm/vmwgfx/vmwgfx_kms.h
+++ b/kernel/mainline/android-mainline/drivers/gpu/drm/vmwgfx/vmwgfx_kms.h
@@ -233,6 +233,7 @@ static const uint32_t __maybe_unused vmw_primary_plane_formats[] = {
